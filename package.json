{
  "name": "@addon-core/browser",
  "version": "0.8.0",
  "description": "TypeScript wrapper for Web Extension APIs",
  "keywords": [
    "browser",
    "addon",
    "extension",
    "google",
    "chrome",
    "opera",
    "edge",
    "firefox",
    "safari",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addon-stack/browser.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/addon-stack/browser",
  "bugs": {
    "url": "https://github.com/addon-stack/browser/issues"
  },
  "license": "MIT",
  "author": "Anjey Tsibylskij (https://github.com/atldays)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@types/chrome": "^0.2.2"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup && node ./scripts/copy-api-types.mjs && node ./scripts/verify-build.mjs",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:staged": "lint-staged",
    "fix": "eslint . --fix --max-warnings 0",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "npm test -- --ci --passWithNoTests --coverage",
    "test:browser-match-patterns": "node ./tests/browser-match-patterns/check.mjs",
    "test:consumer-types": "npm run build && node ./tests/consumer-types/check.mjs",
    "test:related": "npm test -- --bail --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release": "release-it",
    "release:preview": "release-it --no-github.release --no-npm.publish --no-git.tag --ci"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "9.39.5",
    "@release-it/conventional-changelog": "^10.0.1",
    "@stylistic/eslint-plugin": "4.4.1",
    "@types/jest": "^30.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsonc": "2.21.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "15.5.2",
    "release-it": "^19.0.5",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.48.1"
  },
  "lint-staged": {
    "*": "eslint --fix --max-warnings 0 --no-warn-ignored --"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^9.3.5"
    },
    "tsup": {
      "source-map": "^0.7.4"
    }
  }
}
